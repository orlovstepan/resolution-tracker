generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  goals        Goal[]
  checkins     MonthlyCheckin[]
}

model Goal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  type          String    // 'counter' | 'binary' | 'rule'
  unit          String?
  target        Float?
  value         Float     @default(0)
  previousValue Float?
  valueChangedAt DateTime?
  status        String    @default("not_started") // 'not_started' | 'in_progress' | 'done'
  nextMilestone String?   // Deprecated, kept for compatibility
  milestones    String    @default("[]") // JSON array of milestones [{id, text, done}]
  notes         String?
  sortOrder     Int       @default(0) // For manual ordering
  // Rule-specific fields
  ruleType      String?   // 'avoid' (no sugar) | 'achieve' (sports 3x/week)
  ruleTarget    Int?      // how many times per period (null for 'avoid' = every day)
  rulePeriod    String?   // 'day' | 'week' | 'month'
  ruleLogs      String    @default("[]") // JSON array of log entries [{date, success, note?}]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MonthlyCheckin {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthKey     String   // 'YYYY-MM'
  highlight    String   @default("")
  blocker      String   @default("")
  notes        String   @default("")
  snapshotJson String   @default("{}") // JSON string of goal snapshots
  createdAt    DateTime @default(now())

  @@index([userId, monthKey])
}
